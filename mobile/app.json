{
  "expo": {
    "name": "Chatter",
    "slug": "chatter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chatter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "Chatter uses your camera for real-time video calls.",
        "NSMicrophoneUsageDescription": "Chatter uses your microphone for voice and video calls.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.kavindu.chatter",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "armeabi-v7a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "enableBundleCompression": true,
            "gifEnabled": false,
            "webpEnabled": false,
            "networkInspector": false,
            "extraProguardRules": "-dontwarn **\n-keep class com.kavindu.chatter.StickerIntentModule { *; }\n-keep class com.kavindu.chatter.StickerIntentPackage { *; }\n-keep class com.kavindu.chatter.StickerIntentHandler { *; }"
          }
        }
      ],
      "expo-notifications",
      "./plugins/withCallSupport",
      "./plugins/withStickerSupport"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "cfd1c5ef-a9d1-4274-b742-7bea41fcc694"
      }
    }
  }
}
